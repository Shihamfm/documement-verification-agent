# Application Configuration
PROJECT_NAME="Institutional Clinical Document Verification System"
ENVIRONMENT="development"
DEBUG=True

# Authentication & Security
SECRET_KEY="supersecret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# In Docker or production with PostgreSQL + pgvector:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/doc_verify_db"
# Fallback to SQLite if PostgreSQL is not available locally:
SQLITE_FALLBACK=True
SQLITE_DB_PATH="data/verification.db"

# Duplicate Upload Detection (Minutes)
DUPLICATE_WINDOW_MINUTES=5

# Document Storage
UPLOAD_DIR="data/uploads"
MAX_UPLOAD_SIZE_MB=25

# GenAI & LLM Configuration
# Options: "groq" (fast Llama-3.3-70b inference), "offline_deterministic", "gemini", "openai", "ollama"
LLM_PROVIDER="groq"
GROQ_API_KEY="groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Embedding Configuration
# Options: "tfidf_cosine" (zero-dependency, instant cosine similarity), "gemini", "openai"
EMBEDDING_PROVIDER="tfidf_cosine"

# Default Reviewer Seed Credentials
DEFAULT_ADMIN_EMAIL="reviewer@meridianbay.org"
DEFAULT_ADMIN_PASSWORD="ReviewerPassword123!"
DEFAULT_ADMIN_NAME="Dr. Clinical Reviewer"
